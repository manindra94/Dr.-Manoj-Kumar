{
  "entities": {
    "content": {
      "title": "Site Content",
      "description": "Global content for Home and About pages",
      "type": "object",
      "properties": {
        "homepage": {
          "type": "object",
          "description": "Hero, taglines, stats, verticals, announcement banner"
        },
        "about": {
          "type": "object",
          "description": "Bio, profile details, career journey, academic degrees, awards"
        }
      }
    },
    "publications": {
      "title": "Publications & Patents",
      "description": "Research papers, patents, and conference proceedings",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string" },
        "year": { "type": "number" },
        "authors": { "type": "string" },
        "journal": { "type": "string" },
        "abstract": { "type": "string" },
        "citations": { "type": "number" },
        "tags": { "type": "array" },
        "url": { "type": "string" }
      }
    },
    "blog_posts": {
      "title": "Blog Posts & Lab Logs",
      "description": "Laboratory logs, preprints, and updates",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "logCode": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "readTime": { "type": "string" },
        "tags": { "type": "array" }
      }
    },
    "gallery_items": {
      "title": "Gallery Figures",
      "description": "Micrographs, SEM scans, and 3D printing images",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "scaleBar": { "type": "string" },
        "figureNo": { "type": "string" }
      }
    },
    "settings": {
      "title": "System Settings",
      "description": "Portal and application preferences",
      "type": "object",
      "properties": {
        "displayMode": { "type": "string" },
        "accentColor": { "type": "string" },
        "publicProfile": { "type": "boolean" },
        "offlineSyncEnabled": { "type": "boolean" }
      }
    },
    "analytics": {
      "title": "Analytics Metrics",
      "description": "Laboratory analytics and research impact stats",
      "type": "object",
      "properties": {
        "metrics": { "type": "object" },
        "monthlyViews": { "type": "array" },
        "citationGrowth": { "type": "array" }
      }
    },
    "users": {
      "title": "User Accounts",
      "description": "Admin and registered user profiles with roles",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "affiliation": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "messages": {
      "title": "Contact Messages",
      "description": "Visitor contact inquiries and collaboration requests",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "tasks": {
      "title": "Task Reminders",
      "description": "Research deadlines and task reminders",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "priority": { "type": "string" },
        "completed": { "type": "boolean" }
      }
    },
    "telemetry_logs": {
      "title": "Telemetry Logs",
      "description": "System event audit trail",
      "type": "object",
      "properties": {
        "event": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/content/{docId}": {
      "schema": "content",
      "description": "Profile and homepage content documents"
    },
    "/publications/{pubId}": {
      "schema": "publications",
      "description": "Scientific publications collection"
    },
    "/blog_posts/{postId}": {
      "schema": "blog_posts",
      "description": "Research updates and lab log articles"
    },
    "/gallery_items/{itemId}": {
      "schema": "gallery_items",
      "description": "Micrographs and high-resolution figures"
    },
    "/analytics/{docId}": {
      "schema": "analytics",
      "description": "Scientometric and impact metrics"
    },
    "/settings/{docId}": {
      "schema": "settings",
      "description": "User and system preferences"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and permissions"
    },
    "/messages/{messageId}": {
      "schema": "messages",
      "description": "Inquiries from visitors and collaborators"
    },
    "/tasks/{taskId}": {
      "schema": "tasks",
      "description": "Research deadlines and task reminders"
    },
    "/telemetry_logs/{logId}": {
      "schema": "telemetry_logs",
      "description": "System event audit trail"
    }
  }
}
